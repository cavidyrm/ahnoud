# Ahnoud Tech, static site served by Caddy inside the container.
# Traefik terminates TLS and routes the domain; this server listens on :80.
:80 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# hashed-free assets: revalidate the HTML, cache the rest hard
	@immutable path /support.js /image-slot.js /images/* /site.webmanifest
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}
}
